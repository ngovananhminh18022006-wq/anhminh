using System;

class Bai4
{
    static void Main()
    {
        Console.Write("Nhap chuoi: ");
        string s = Console.ReadLine();

        string dao = "";

        for (int i = s.Length - 1; i >= 0; i--)
        {
            dao += s[i];
        }

        Console.WriteLine("Chuoi sau khi dao nguoc: " + dao);
    }
}
